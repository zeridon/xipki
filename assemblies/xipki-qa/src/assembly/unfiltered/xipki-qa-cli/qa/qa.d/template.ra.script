# Certificate rfc3739

csr-p12 REPLACEME-RSAPSS --p12 output/rfc3739.p12 --password CHANGEIT \
  --subject "CN=rfc3739.myorg.org,O=myorg,C=DE" \
  --extensions-file qa/extensions/rfc3739.der \
  --outform $OUTFORM \
  --out output/rfc3739.csr

cmp-csr-enroll --csr output/rfc3739.csr --ca subca --profile rfc3739 \
  --outform $OUTFORM --out output/rfc3739.crt \
  --signer-password $[cmp.client.keyPassword] --signer-p12 ${SIGNER_P12}

update-cert-p12 --p12 output/rfc3739.p12 --password CHANGEIT \
  --cert output/rfc3739.crt --ca-cert output/subca1.crt \
  --ca-cert output/rootca1.crt

