# Certificate for PKCS#11 key

cmp-enroll-p11 REPLACEME-RSAPSS --ca subca --profile tls --slot $SLOT \
  --key-label ${EE_P11_LABEL_PREFIX}p11-tls-cmp --outform $OUTFORM \
  --out output/p11-tls-cmp.crt \
  --subject "CN=p11-tls-cmp.example.org,O=myorg,C=DE" \
  --signer-password $[cmp.client.keyPassword] --signer-p12 ${SIGNER_P12}

## Get CRL
cmp-get-crl --ca subcawithcrl --outform $OUTFORM \
  --out output/subcawithcrl1-1-get.crl

source qa/scep.script
