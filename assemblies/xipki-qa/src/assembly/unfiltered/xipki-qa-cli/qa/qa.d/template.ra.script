## Suspend certificates
cmp-revoke --ca subca1 --cert output/tls1.crt --cert output/tls2.crt \
  --ca-cert output/subca1.crt --reason certificateHold \
  --signer-password $[cmp.client.keyPassword] --signer-p12 ${SIGNER_P12}

cmp-unsuspend --ca subca1 --cert output/tls1.crt --cert output/tls2.crt \
  --ca-cert output/subca1.crt --signer-password $[cmp.client.keyPassword] \
  --signer-p12 ${SIGNER_P12}

## Revoke certificates
cmp-revoke --ca subca1 --cert output/tls2.crt --ca-cert output/subca1.crt \
  --reason affiliationChanged --signer-password $[cmp.client.keyPassword] \
  --signer-p12 ${SIGNER_P12}

