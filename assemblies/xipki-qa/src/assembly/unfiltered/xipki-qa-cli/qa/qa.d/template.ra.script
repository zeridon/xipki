## Generate CRL
gen-crl --ca rootca1 --outform $OUTFORM --out output/rootca1-camgmt-gen.crl

gen-crl --ca subcawithcrl1 --outform $OUTFORM \
  --out output/subcawithcrl1-camgmt-gen.crl

gen-crl --ca subca1 --outform $OUTFORM --out output/subca1-camgmt-gen.crl

## Get CRL
get-crl --ca rootca1 --outform $OUTFORM --out output/rootca1-camgmt-get.crl

get-crl --ca subcawithcrl1 --outform $OUTFORM \
  --out output/subcawithcrl1-camgmt-get.crl

csr-p12 REPLACEME-RSAPSS --p12 output/cross1.p12 --password CHANGEIT \
  --subject "CN=cross1,O=myorg,C=DE" --outform $OUTFORM \
  --out output/cross1.csr

enroll-cert --ca rootca1 --profile cross --csr output/cross1.csr \
  --outform $OUTFORM --out output/cross1.crt

echo "#################################################################"
echo "#                Manage certificate over CMP                    #"
echo "#################################################################"

set SIGNER_P12 xipki/keycerts/cmp-client.p12

## Enroll certificates
# Certificate ocsp1

## Create the CSR for the command caqa:check-cert in QA
csr-p12 REPLACEME-RSAPSS --p12 output/ocsp1.p12 --password CHANGEIT \
  --outform $OUTFORM --out output/ocsp1.csr \
  --subject "CN=ocsp1,2.5.4.97=VATDE-123456789,O=myorg,C=DE"

cmp-enroll-p12 REPLACEME-RSAPSS --ca subcawithcrl --profile OCSP \
  --p12 output/ocsp1.p12 --password CHANGEIT --outform $OUTFORM \
  --out output/ocsp1.crt \
  --subject "CN=ocsp1,2.5.4.97=VATDE-123456789,O=myorg,C=DE" \
  --signer-password $[cmp.client.keyPassword] --signer-p12 ${SIGNER_P12}

update-cert-p12 --p12 output/ocsp1.p12 --password CHANGEIT \
  --cert output/ocsp1.crt --ca-cert output/subcawithcrl1.crt \
  --ca-cert output/rootca1.crt

# Certificate ocsp2

## Create the CSR for the command caqa:check-cert in QA
csr-p12 REPLACEME-RSAPSS --p12 output/ocsp2.p12 --password CHANGEIT \
  --outform $OUTFORM --out output/ocsp2.csr \
  --subject "CN=ocsp2,2.5.4.97=VATDE-123456789,O=myorg,C=DE"

cmp-enroll-p12 REPLACEME-RSAPSS --ca subcawithcrl --profile OCSP \
  --p12 output/ocsp2.p12 --password CHANGEIT --outform $OUTFORM \
  --out output/ocsp2.crt \
  --subject "CN=ocsp2,2.5.4.97=VATDE-123456789,O=myorg,C=DE" \
  --signer-password $[cmp.client.keyPassword] --signer-p12 ${SIGNER_P12}

update-cert-p12 --p12 output/ocsp2.p12 --password CHANGEIT \
  --cert output/ocsp2.crt --ca-cert output/subcawithcrl1.crt \
  --ca-cert output/rootca1.crt

# CMP update
cmp-update-p12 --ca subcawithcrl --p12 output/ocsp2.p12 --password CHANGEIT \
  --out output/ocsp2-updated.crt --oldcert output/ocsp2.crt \
  --signer-password $[cmp.client.keyPassword] --signer-p12 ${SIGNER_P12}

# CMP: Enroll (CA generate key pair) via CRMF
set CN cmp-crmf-ca-genkey-tls

cmp-enroll-serverkeygen --ca subca --profile tls --p12-out output/${CN}.p12 \
  --password CHANGEIT --cert-outform $OUTFORM --cert-out output/${CN}.crt \
  --subject "CN=${CN}.myorg.org,O=myorg,C=DE" \
  --signer-password $[cmp.client.keyPassword] --signer-p12 ${SIGNER_P12}

source qa/qa.d/ra-serverkeygen.script

## Revocate certificates
cmp-revoke --ca subcawithcrl --ca-cert output/subcawithcrl1.crt \
  --cert output/ocsp2.crt --reason keyCompromise \
  --signer-password $[cmp.client.keyPassword] --signer-p12 ${SIGNER_P12}

