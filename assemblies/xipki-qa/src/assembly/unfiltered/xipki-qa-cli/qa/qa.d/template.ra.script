# Certificate ee-complex1 with complex subject (parsable in openssl)

csr-p12 REPLACEME-RSAPSS --p12 output/ee-complex1.p12 --password CHANGEIT \
  --outform $OUTFORM --out output/ee-complex1.csr \
  --subject \
  "UID=abc-def,CN=ee-complex1,O=myorg,C=DE,1.3.6.1.4.1.311.60.2.1.3=CN,1.3.6.1.4.1.311.60.2.1.2=Guandong,1.3.6.1.4.1.311.60.2.1.1=Shenzhen" \
  --san '[0]1.2.3.1=SAN-I am otherName 1.2.3.1' \
  --san '[0]1.2.3.2=SAN-I am otherName 1.2.3.2' \
  --san '[1]SNA-info@myorg.org' \
  --san '[2]SAN-dns.myorg.org' \
  --san '[4]CN=demo,C=DE' \
  --san '[5]SAN-assigner1=SAN-party1' \
  --san '[6]SAN-uri.myorg.org' \
  --san '[7]69.1.2.190' \
  --san '[8]2.3.4.5' \
  --sia '1.3.6.1.5.5.7.48.5=[0]1.2.3.1\=SIA-I am otherName 1.2.3.1' \
  --sia '2.3.4.1=[0]1.2.3.2\=SIA-I am otherName 1.2.3.2' \
  --sia '2.3.4.2=[1]SNA-info@myorg.org' --sia '2.3.4.3=[2]SIA-dns.myorg.org' \
  --sia '2.3.4.4=[4]CN\=demo\,C\=DE' \
  --sia '2.3.4.5=[5]SIA-assigner1\=SIA-party1' \
  --sia '2.3.4.6=[6]SIA-uri.myorg.org' --sia '2.3.4.7=[7]69.1.2.190' \
  --sia '2.3.4.8=[8]2.3.4.5' \
  --extensions-file qa/extensions/ee-complex.der

cmp-csr-enroll --csr output/ee-complex1.csr --ca subca --profile ee-complex \
  --outform $OUTFORM --out output/ee-complex1.crt \
  --signer-password $[cmp.client.keyPassword] --signer-p12 ${SIGNER_P12}

update-cert-p12 --p12 output/ee-complex1.p12 --password CHANGEIT \
  --cert output/ee-complex1.crt --ca-cert output/subca1.crt \
  --ca-cert output/rootca1.crt

# Certificate ee-complex2 with complex subject (not parsable in openssl due to \
  complex subject)

csr-p12 REPLACEME-RSAPSS --p12 output/ee-complex2.p12 --password CHANGEIT \
  --outform $OUTFORM --out output/ee-complex2.csr \
  --subject \
  "UID=abc-def,CN=ee-complex2,O=myorg,C=DE,1.3.6.1.4.1.311.60.2.1.3=CN,1.3.6.1.4.1.311.60.2.1.2=Guandong,1.3.6.1.4.1.311.60.2.1.1=Shenzhen" \
  --san '[0]1.2.3.1=SAN-I am otherName 1.2.3.1' \
  --san '[0]1.2.3.2=SAN-I am otherName 1.2.3.2' \
  --san '[1]SNA-info@myorg.org' \
  --san '[2]SAN-dns.myorg.org' \
  --san '[4]CN=demo,C=DE' \
  --san '[5]SAN-assigner1=SAN-party1' \
  --san '[6]SAN-uri.myorg.org' \
  --san '[7]69.1.2.190' --san '[8]2.3.4.5' \
  --sia '1.3.6.1.5.5.7.48.5=[0]1.2.3.1\=SIA-I am otherName 1.2.3.1' \
  --sia '2.3.4.1=[0]1.2.3.2\=SIA-I am otherName 1.2.3.2' \
  --sia '2.3.4.2=[1]SNA-info@myorg.org' --sia '2.3.4.3=[2]SIA-dns.myorg.org' \
  --sia '2.3.4.4=[4]CN\=demo\,C\=DE' \
  --sia '2.3.4.5=[5]SIA-assigner1\=SIA-party1' \
  --sia '2.3.4.6=[6]SIA-uri.myorg.org' --sia '2.3.4.7=[7]69.1.2.190' \
  --sia '2.3.4.8=[8]2.3.4.5' \
  --extensions-file qa/extensions/ee-complex.der

cmp-csr-enroll --csr output/ee-complex2.csr --ca subca --profile ee-complex \
  --outform $OUTFORM --out output/ee-complex2.crt \
  --signer-password $[cmp.client.keyPassword] --signer-p12 ${SIGNER_P12}

update-cert-p12 --p12 output/ee-complex2.p12 --password CHANGEIT \
  --cert output/ee-complex2.crt --ca-cert output/subca1.crt \
  --ca-cert output/rootca1.crt

# Certificates constant-ext1

set list [ constant-ext ]

for it in $list
  set certname $it

  csr-p12 REPLACEME-RSAPSS --subject "CN=${certname}1,O=myorg,C=DE" \
    --p12 output/${certname}1.p12 --password CHANGEIT --outform $OUTFORM \
    --out output/${certname}1.csr

  cmp-csr-enroll --csr output/${certname}1.csr --ca subca \
    --profile ${certname} --outform $OUTFORM --out output/${certname}1.crt \
    --signer-password $[cmp.client.keyPassword] --signer-p12 ${SIGNER_P12}

  update-cert-p12 --p12 output/${certname}1.p12 --password CHANGEIT \
    --cert output/${certname}1.crt --ca-cert output/subca1.crt \
    --ca-cert output/rootca1.crt
done

